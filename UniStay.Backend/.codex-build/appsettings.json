{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}" }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "[{Application}][{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithProcessId", "WithMachineName" ]
  },
  "ConnectionStrings": {
    "Main": "Server=DESKTOP-1BONMU3\\MSSQLSERVER01;Database=UniStayV2;Trusted_Connection=True;User ID=sa;Password=test;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "UniStay.Api",
    "Audience": "UniStay.Spa",
    "Key": "DEV_ONLY_CHANGE_ME_TO_LONG_RANDOM_SECRET",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Stripe": {
    "SecretKey": "TODO_CONFIGURE_STRIPE_SECRET_KEY",
    "PublishableKey": "TODO_CONFIGURE_STRIPE_PUBLISHABLE_KEY",
    "WebhookSecret": "TODO_CONFIGURE_STRIPE_WEBHOOK_SECRET"
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUser": "TODO_CONFIGURE_SMTP_USER",
    "SmtpPass": "TODO_CONFIGURE_SMTP_PASSWORD"
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "App": {
    "BaseUrl": "http://localhost:4200"
  },
  "Recaptcha": {
    "SecretKey": "TODO_CONFIGURE_RECAPTCHA_SECRET_KEY"
  },
  "Firebase": {
    "ServiceAccountJson": "TODO_CONFIGURE_FIREBASE_SERVICE_ACCOUNT_JSON"
  }
}
